{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Triton One",
  "theme": "luma",
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://triton.one"
  },
  "colors": {
    "primary": "#7A4BA0",
    "light": "#B591D3",
    "dark": "#492D60"
  },
  "fonts": {
    "heading": {
      "family": "DM Sans"
    },
    "body": {
      "family": "Work Sans"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#F7F7F7",
      "dark": "#171717"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "api": {
    "mdx": {
      "server": "https://api.mainnet-beta.solana.com"
    },
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python",
        "rust"
      ],
      "defaults": "required"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://triton.one"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Customer Portal",
      "href": "https://customers.triton.one"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "pages": [
          "getting-started"
        ]
      },
      {
        "group": "Solana RPC playground",
        "pages": [
          "solana-rpc/overview",
          "solana-rpc/get-balance",
          "solana-rpc/get-slot",
          "solana-rpc/get-block-height",
