{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Triton One",
  "theme": "luma",
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/mark.svg",
    "dark": "/logo/mark.svg",
    "href": "https://triton.one"
  },
  "colors": {
    "primary": "#7A4BA0",
    "light": "#B591D3",
    "dark": "#492D60"
  },
  "fonts": {
    "heading": {
      "family": "DM Sans"
    },
    "body": {
      "family": "Work Sans"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#F7F7F7",
      "dark": "#171717"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": "css-variables"
    },
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "api": {
    "mdx": {
      "server": "https://api.mainnet-beta.solana.com"
    },
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python",
        "rust"
      ],
      "defaults": "required"
    }
  },
