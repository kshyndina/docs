{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Triton One",
  "theme": "luma",
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://triton.one"
  },
  "colors": {
    "primary": "#7A4BA0",
    "light": "#B591D3",
    "dark": "#492D60"
  },
  "fonts": {
    "heading": {
      "family": "DM Sans"
    },
    "body": {
      "family": "Work Sans"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#F7F7F7",
      "dark": "#171717"
    }
  },
  "styling": {
    "codeblocks": "dark"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/rpcpool"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "getting-started",
              "core-features"
            ]
          },
          {
            "group": "Streaming",
            "pages": [
              "streaming/overview",
              "streaming/dragons-mouth-grpc",
              "streaming/whirligig-websockets",
              "streaming/fumarole",
              "streaming/vixen-program-streams"
            ]
          },
          {
            "group": "Solana",
            "pages": [
              "solana/overview",
              "solana/cascade-transactions",
              "solana/digital-assets-api",
              "solana/old-faithful-archive",
              "solana/steamboat-indexes",
              "solana/shield-policies",
              "solana/photon"
            ]
          },
          {
            "group": "Trading APIs",
            "pages": [
              "trading-apis/overview",
              "trading-apis/metis-swap",
              "trading-apis/titan-swap",
              "trading-apis/jito-bundles",
              "trading-apis/pyth-hermes"
            ]
          },
          {
            "group": "Other Chains",
            "pages": [
              "chains/sui",
              "chains/monad",
              "chains/pythnet"
            ]
          },
          {
            "group": "Validators",
            "pages": [
              "validators/overview",
              "validators/vote-account-setup",
              "validators/node-identity-protection"
            ]
          },
          {
            "group": "Support",
            "pages": [
              "support/faq",
              "support/security",
              "support/streaming-troubleshooting"
            ]
          }
        ]
