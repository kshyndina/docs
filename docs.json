      {
        "tab": "Account Management API",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "account-api/introduction",
              "account-api/authentication"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "account-api/accounts",
              "account-api/subscriptions",
              "account-api/endpoints",
              "account-api/tokens",
              "account-api/rate-tiers",
              "account-api/address-watch-lists",
              "account-api/payments"
