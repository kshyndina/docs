{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Triton One",
  "theme": "luma",
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://triton.one"
  },
  "colors": {
    "primary": "#7A4BA0",
    "light": "#B591D3",
    "dark": "#492D60"
  },
  "fonts": {
    "heading": {
      "family": "DM Sans"
    },
    "body": {
      "family": "Work Sans"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#F7F7F7",
      "dark": "#171717"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "api": {
    "mdx": {
      "server": "https://api.mainnet-beta.solana.com"
    },
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python",
        "rust"
      ],
      "defaults": "required"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://triton.one"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Customer Portal",
      "href": "https://customers.triton.one"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "pages": [
          "getting-started"
        ]
      },
      {
        "group": "Solana RPC playground",
        "pages": [
          "solana-rpc/overview",
          "solana-rpc/get-balance",
          "solana-rpc/get-slot",
          "solana-rpc/get-block-height",
          "solana-rpc/get-latest-blockhash",
          "solana-rpc/get-account-info"
        ]
      },
      {
        "group": "Core features",
        "pages": [
          "core-features/introduction",
          "core-features/geodns",
          "core-features/proxying",
          "core-features/ratelimits",
          "core-features/abuse-prevention",
          "core-features/privacy-and-security",
          "core-features/data-privacy",
          "core-features/support-faqs"
        ]
      },
      {
        "group": "Chains",
        "pages": [
          "chains/solana",
          "chains/sui",
          "chains/monad",
          "chains/pythnet",
          "chains/others"
        ]
      },
      {
        "group": "Digital Assets API",
        "pages": [
          "digital-assets-api/introduction",
          "digital-assets-api/fungible-assets",
          "digital-assets-api/metaplex-digital-assets-api"
        ]
      },
      {
        "group": "Yellowstone (streaming)",
        "pages": [
          "project-yellowstone/introduction",
          "project-yellowstone/dragons-mouth-grpc-subscriptions",
          "project-yellowstone/fumarole",
          "project-yellowstone/whirligig-websockets",
          "project-yellowstone/program-data-streams",
          "project-yellowstone/steamboat-custom-indexes",
          "project-yellowstone/shield-transaction-policies",
          "project-yellowstone/old-faithful-historical-archive"
        ]
      },
      {
        "group": "Account management",
        "pages": [
          "account-management/api-access",
          "account-management/payments"
        ]
      },
      {
        "group": "Trading APIs",
        "pages": [
          "trading-apis/introduction",
          "trading-apis/hermes",
          "trading-apis/metis-swap-api",
          "trading-apis/titan-swap-api",
          "trading-apis/bundle-simulation-with-jito"
        ]
      },
      {
        "group": "Validators",
        "pages": [
          "validators/introduction",
          "validators/vote-account-setup",
          "validators/node-identity-protection"
        ]
      },
      {
        "group": "Pyth publishers",
        "pages": [
          "pyth-publishers/nginx-proxy",
          "pyth-publishers/testnet-devnet-and-pythnet"
        ]
      }
    ]
  }
}
